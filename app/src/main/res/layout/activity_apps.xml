<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".activity.AppsActivity">

        <!-- 自定义轻量标题栏（替代原生 ActionBar） -->
        <LinearLayout
            android:id="@+id/cl_custom_title"
            style="@style/CustomTitleBarStyle"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_title"
                style="@style/CustomTitleTextStyle"
                android:text="@string/title_activity_apps" />
        </LinearLayout>

        <!-- 搜索栏：应用名称 / 包名 过滤 + 是否包括系统应用 -->
        <LinearLayout
            android:id="@+id/ll_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/area_margin"
            android:paddingRight="@dimen/area_margin"
            android:gravity="center_vertical"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cl_custom_title">

            <EditText
                android:id="@+id/et_search"
                style="@style/defEditStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:inputType="text"
                android:hint="@string/hint_search_app"
                android:imeOptions="actionDone" />

            <CheckBox
                android:id="@+id/cb_include_system"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cb_include_system"
                android:checked="true" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_save"
            style="@style/defButtonStyle"
            android:layout_width="0dp"
            android:layout_marginLeft="@dimen/area_margin"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="10dp"
            android:text="@string/btn_save"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/btn_back" />

        <Button
            android:id="@+id/btn_back"
            style="@style/defButtonStyle"
            android:layout_width="0dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="@dimen/area_margin"
            android:text="@string/btn_back"
            app:layout_constraintBottom_toBottomOf="@id/btn_save"
            app:layout_constraintLeft_toRightOf="@id/btn_save"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/btn_save" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:overScrollMode="never"
            app:layout_constraintBottom_toTopOf="@id/btn_save"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_search" />

        <TextView
            android:id="@+id/tv_loading"
            style="@style/defTextStyle"
            android:text="@string/loading"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/rv_list"
            app:layout_constraintBottom_toBottomOf="@id/rv_list"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>